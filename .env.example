# ==========================================
# ANOTHER ME - ENVIRONMENT CONFIGURATION
# ==========================================

# Supabase PostgreSQL & Auth Credentials
# (If not provided, Another Me runs in interactive local sandbox / demo mode)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional AI Inference Providers (Server-side or Edge Functions)
# LLM Provider: Meta Llama 3.3 70B via OpenRouter / Groq / Cloudflare Workers AI
VITE_LLM_PROVIDER=meta-llama-3.3-70b
VITE_OPENROUTER_API_KEY=

# Optional Speech & Voice Synthesis (e.g., ElevenLabs / Cartesia)
VITE_ELEVENLABS_API_KEY=
VITE_ELEVENLABS_VOICE_ID=
